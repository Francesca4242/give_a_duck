{
  // Cloudflare Worker: serves the app (bundled from ./public at build time) and runs
  // online rooms (one Durable Object per room code).
  "name": "give-a-duck",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "build": { "command": "node scripts/build-static.mjs", "watch_dir": "public" },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "observability": { "enabled": true }
}
